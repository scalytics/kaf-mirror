    {
      "@type": "SoftwareApplication",
      "@id": "{{SITE}}#software",
      "name": "kaf-mirror",
      "url": "{{SITE}}",
      "description": "kaf-mirror is Kafka backup you can watch, audit and trust: a server binary with a dashboard that copies topics between Kafka-protocol clusters. Exact copies, idempotent writes, an audit trail, compliance reports and Replication halt (tech preview). Apache Kafka, Confluent, Redpanda and Azure Event Hubs can be the source or the target, and KafScale is a supported target. The server and admin-cli run on Linux; the Docker image is linux/amd64 and linux/arm64; mirror-cli also ships for macOS and Windows. Apache 2.0.",
      "applicationCategory": "DeveloperApplication",
      "applicationSubCategory": "Kafka backup",
      "operatingSystem": "Linux, Docker, Kubernetes; mirror-cli also on macOS and Windows",
      "programmingLanguage": "Go",
      "license": "https://www.apache.org/licenses/LICENSE-2.0",
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "featureList": [
        "Replicate topics from one Kafka cluster to another",
        "Same-name, exact and regex topic mapping",
        "Source offsets committed only after the target acknowledges the write",
        "TLS, mTLS, SASL PLAIN, SCRAM and Kerberos",
        "Role-based access with admin, operator, monitoring and compliance roles",
        "Audit trail and scheduled compliance reports",
        "Web dashboard, REST API, admin CLI and management CLI",
        "Helm chart for Kubernetes",
        "Shell completion for the management and admin CLIs"
      ],
