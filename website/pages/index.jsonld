      "@type": "SoftwareApplication",
      "@id": "{{SITE}}#software",
      "name": "kaf-mirror",
      "url": "{{SITE}}",
      "description": "kaf-mirror mirrors topics between any two Kafka clusters over the Kafka protocol, with a web dashboard, a management CLI, an audit trail and compliance reports. Apache Kafka, Confluent, Redpanda and Azure Event Hubs can be the source or the target, and KafScale is a supported target.",
      "applicationCategory": "DeveloperApplication",
      "applicationSubCategory": "Kafka replication",
      "operatingSystem": "Linux, Docker, Kubernetes",
      "programmingLanguage": "Go",
      "license": "https://www.apache.org/licenses/LICENSE-2.0",
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "featureList": [
        "Replicate topics from one Kafka cluster to another",
        "Same-name, exact and regex topic mapping",
        "Source offsets committed only after the target acknowledges the write",
        "TLS, mTLS, SASL PLAIN, SCRAM and Kerberos",
        "Role-based access with admin, operator, monitoring and compliance roles",
        "Audit trail and scheduled compliance reports",
        "Web dashboard, REST API, admin CLI and management CLI",
        "Helm chart for Kubernetes"
      ],
